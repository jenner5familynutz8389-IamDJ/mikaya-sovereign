{
  "schema": "mikaya.interop.expected-runtime-profile.v1",
  "id": "act-pixel8-source",
  "label": "ACT Pixel 8 published example reference - not an admission policy",
  "purpose": "source-hardware-reference",
  "sourceDeclaredOnly": true,
  "sources": [
    {
      "url": "https://github.com/bospaladin34-crypto/Omega_standalone_developments/blob/623dc555382cafeda8328f57e6d61ff3f71ffed3/11_omega_edge_workers/c11_universal_worker/edge_device_profile.example.json",
      "description": "Example profile declarations - not independently observed hardware"
    }
  ],
  "checks": [
    { "id": "model-marker", "fact": "android.model", "operator": "contains", "expected": "Pixel 8", "required": true },
    { "id": "soc-marker", "fact": "android.soc", "operator": "contains", "expected": "Tensor G3", "required": true },
    { "id": "process-architecture", "fact": "runtime.arch", "operator": "eq", "expected": "arm64", "required": true },
    { "id": "kernel-marker", "fact": "system.kernelRelease", "operator": "prefix", "expected": "6.1.172-android14", "required": true },
    { "id": "avf-unprobed", "fact": "virtualization.avf", "operator": "eq", "expected": true, "required": false },
    { "id": "root-unprobed", "fact": "privilege.rootAvailable", "operator": "eq", "expected": true, "required": false }
  ]
}
