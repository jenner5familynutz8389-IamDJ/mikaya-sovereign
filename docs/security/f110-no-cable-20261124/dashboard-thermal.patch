+MTG_SOURCE_SHA256 = '6d41877fa3e288cf17cfab8b7b323090a001eacc0770108404aa3e7c18cad933'
+
+def native_thermal_result(rc, data):
+ result={'mode':'unavailable','source':'android_ndk_thermal_api','at':None,
+         'optional_work_allowed':False,'verified_healthy':False,
+         'native_optional_decision':'HOLD','android_thermal_severity':None}
+ if not isinstance(data,dict):return result
+ severity=data.get('android_thermal_severity')
+ if type(severity) is not int or not 0<=severity<=6 or data.get('factory_throttling_modified') is not False:return result
+ allowed=severity in (0,1)
+ if (rc,data.get('decision_for_optional_jobs')) != ((0,'ALLOW') if allowed else (75,'HOLD')):return result
+ result.update(mode='normal' if allowed else 'hold',at=iso(),verified_healthy=allowed,
+               native_optional_decision='ALLOW' if allowed else 'HOLD',android_thermal_severity=severity)
+ return result
+
+def native_thermal(home,prefix):
+ try:
+  p=home/'.local/share/mikaya/mtg_policy.py'
+  st=p.lstat()
+  if not stat.S_ISREG(st.st_mode) or st.st_nlink!=1 or st.st_uid!=os.getuid() or st.st_mode&0o022 or st.st_size>65536:return native_thermal_result(-1,{})
+  if hashlib.sha256(p.read_bytes()).hexdigest()!=MTG_SOURCE_SHA256:return native_thermal_result(-1,{})
+  r=subprocess.run([str(prefix/'bin/python3'),'-I','-B',str(p),'status'],capture_output=True,text=True,timeout=3,check=False)
+  if len(r.stdout)>4096:return native_thermal_result(-1,{})
+  return native_thermal_result(r.returncode,json.loads(r.stdout))
+ except (OSError,ValueError,subprocess.SubprocessError):return native_thermal_result(-1,{})
